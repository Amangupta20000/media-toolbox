{
  "name": "media-toolbox",
  "version": "1.0.0",
  "private": true,
  "description": "Native-agent powered media conversion, repair, and PDF editing tools for local desktop processing.",
  "author": {
    "name": "Aman Gupta",
    "email": "a20000.gupta@gmail.com"
  },
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "node scripts/dev.js",
    "dev:web": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "test": "node --test --test-reporter=spec",
    "start": "node .next/standalone/server.js",
    "worker": "node worker/index.js",
    "agent:dev": "node agent/index.js",
    "agent": "electron agent/electron-main.cjs",
    "agent:package": "node scripts/package-agent.mjs",
    "agent:update-keygen": "node scripts/generate-agent-runtime-update-key.mjs",
    "agent:license-keygen": "node scripts/generate-agent-license.mjs --keygen",
    "agent:license": "node scripts/generate-agent-license.mjs",
    "license-server": "node license-server/index.js",
    "license-server:funnel": "node scripts/license-server-funnel.mjs",
    "license-server:keygen": "node scripts/license-server-keygen.mjs",
    "setup:untrunc": "bash scripts/setup-untrunc-macos.sh",
    "lint": "next lint"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@napi-rs/canvas": "^1.0.9",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "better-sqlite3": "^11.10.0",
    "busboy": "^1.6.0",
    "electron-updater": "^6.8.9",
    "fontkit": "^2.0.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0"
  }
}
