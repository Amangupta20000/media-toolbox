DATA_DIR=./data
JOB_RETENTION_HOURS=2
IMAGE_MAX_BYTES=26214400
VIDEO_MAX_BYTES=2147483648
PDF_MAX_BYTES=52428800
PDF_TOTAL_MAX_BYTES=262144000
PDF_IMAGE_MAX_BYTES=26214400
UNTRUNC_PATH=/usr/local/bin/untrunc
# Optional local fallback. This must match the source recorder's codec,
# resolution, frame rate, and recording settings.
UNTRUNC_REFERENCE_PATH=
NEXT_PUBLIC_APP_NAME=Media Toolbox
# Optional website URL for the local agent. HTTP is used for local development;
# secure HTTPS pages automatically use the packaged agent's HTTPS loopback endpoint.
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:4789
# GitHub Releases page containing macOS, Windows, and Linux agent installers.
NEXT_PUBLIC_AGENT_RELEASES_URL=https://github.com/Amangupta20000/media-toolbox/releases/latest
NEXT_PUBLIC_MACOS_AGENT_SIGNED=false
# Public HTTPS URL of the licensing-only service. Leave empty when using only
# offline agent licenses. This value is safe to expose in the browser bundle.
NEXT_PUBLIC_LICENSE_SERVER_URL=
# Licensing service: use the dedicated exFAT directory on the SSD in production.
LICENSE_SERVER_HOST=127.0.0.1
LICENSE_SERVER_PORT=4900
LICENSE_DATA_DIR=/Volumes/Sandisk Exf/MediaToolboxLicensing
LICENSE_VOLUME_UUID=62D322F6-B7D6-3CB4-BB99-0A0A428E3F58
LICENSE_PUBLIC_ORIGINS=https://media-toolbox-woad.vercel.app,http://localhost:3000,http://127.0.0.1:3000
# Owner-only GitHub integration. Keep the token on the SSD server; never add it to Vercel.
LICENSE_GITHUB_TOKEN=
LICENSE_GITHUB_REPOSITORY=Amangupta20000/media-toolbox
LICENSE_GITHUB_API_URL=https://api.github.com
# The agent uses this URL when redeeming an online activation code. It is not
# needed by the frontend and should be configured in the agent runtime/release.
AGENT_LICENSE_SERVER_URL=
