APP_USERNAME=admin
APP_PASSWORD=12345
AUTH_SECRET=replace-with-a-long-random-string
DATA_DIR=./data
JOB_RETENTION_HOURS=2
IMAGE_MAX_BYTES=26214400
VIDEO_MAX_BYTES=2147483648
PDF_MAX_BYTES=52428800
PDF_TOTAL_MAX_BYTES=262144000
PDF_IMAGE_MAX_BYTES=26214400
UNTRUNC_PATH=/usr/local/bin/untrunc
# Optional local fallback. This must match the source recorder's codec,
# resolution, frame rate, and recording settings.
UNTRUNC_REFERENCE_PATH=
NEXT_PUBLIC_APP_NAME=Media Toolbox
# Optional website URL for the local agent. HTTP is used for local development;
# secure HTTPS pages automatically use the packaged agent's HTTPS loopback endpoint.
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:4789
# GitHub Releases page containing macOS, Windows, and Linux agent installers.
NEXT_PUBLIC_AGENT_RELEASES_URL=https://github.com/Amangupta20000/media-toolbox/releases/latest
